  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tLos decretos son mejoras permanentes que se mantienen incluso al morir
    o cerrar el juego. Incrementan las estad\xEDsticas base del jugador y tambi\xE9n
    mejoran las probabilidades de obtener Epifan\xEDas de mayor calidad.\n\n\tSe
    adquieren utilizando Esencia Angelical obtenida al derrotar enemigos.\n\t\n\tPara
    acceder al men\xFA de decretos, el jugador debe acercarse a una estatua en el
    nivel base y presionar la tecla Espacio. Cada estatua ofrece decretos diferentes."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d58e720709795f647803657b3859f3e5, type: 2}
  m_sharedMaterial: {fileID: -4638299169193150074, guid: d58e720709795f647803657b3859f3e5, type: 2}
