  dialogos:
  - personaje: 1
    texto: "Veo que est\xE1s aqu\xED\u2026 otra vez."
  - personaje: 2
    texto: "\xBFCu\xE1ntas veces m\xE1s tendr\xE9 que pasar por esto para derrotarla
