  m_Script: {fileID: 11500000, guid: 88bf5d8e082d5b9419597401f6983d4c, type: 3}
  m_Name: Info Mel
  m_EditorClassIdentifier: 
  _id: 3f73afb3-ac2f-4305-aa38-1841ab614d97
  _prioridad: 7
  _leida: 0
  unica: 0
  dialogos:
  - personaje: 2
    texto: "\xBFQu\xE9 pod\xE9s decirme de Mel?"
  - personaje: 1
    texto: "La detesto. Era el entretenimiento de Dios\u2026 siempre danzando de
      un lado a otro."
  - personaje: 1
    texto: "Irradiando esa falsa alegr\xEDa que manten\xEDa hechizado a todo el Para\xEDso."
  - personaje: 1
    texto: "Pero yo\u2026 nunca le cre\xED. Y ella lo sab\xEDa."
  - personaje: 1
    texto: "Por eso fue la primera en correr con Dios\u2026 a susurrarle cada uno
      de mis errores."
  - personaje: 1
    texto: "Por su culpa\u2026 estoy aqu\xED. Y ella all\xE1 arriba, siendo su mano
      derecha."
  primeraMuerte: 0
  primerEnfrentamientoMel: 1
  primerVictoriaMel: 0
  ultimaVictoriaMel: 0
