  dialogos:
  - personaje: 3
    texto: "Esto que est\xE1s logrando\u2026 no es m\xE1s que suerte."
  - personaje: 3
    texto: "Pero ac\xE1, la jueza\u2026 soy yo."
  - personaje: 3
    texto: "El poder\u2026 soy yo."
  - personaje: 3
    texto: "La que manda aqu\xED\u2026 soy yo."
  - personaje: 3
    texto: "Y vos\u2026 no vas a pasar de aqu\xED."
